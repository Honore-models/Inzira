# ============================================================
# INZIRA - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth.js / NextAuth (use `openssl rand -base64 32` to generate AUTH_SECRET)
AUTH_SECRET=replace-with-a-long-random-secret

# Optional Google sign-in. Leave both unset to hide the Google option.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Required before registering an officer account through the app.
OFFICER_SIGNUP_CODE=share-this-securely-with-authorized-officers

# OpenRouter (used for both LLM generation and BGE-M3 embeddings)
OPENROUTER_API_KEY=sk-or-...

# Generation model (Gemma 4 26B A4B via OpenRouter)
AI_MODEL=google/gemma-4-26b-a4b-it:free

# Embedding model (BGE-M3 via OpenRouter)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG retrieval settings
RAG_TOP_K=8
