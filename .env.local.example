# ============================================================
# INZIRA — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# --- Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # server only

# --- Auth.js --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of the site (used for metadata, sitemap and OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google sign-in (leave unset to hide the button)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# --- Officer registration ------------------------------------
# Officers need this code to register.
OFFICER_SIGNUP_CODE=share-this-securely-with-authorized-officers
# Staging/demo only: shows a "use test code" button on sign-up.
ENABLE_TEST_OFFICER_SIGNUP=false
# TEST_OFFICER_INVITATION_CODE=

# --- AI: Groq (free tier) -------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Models are tried in order; each has its own rate-limit bucket.
AI_MODEL=llama-3.3-70b-versatile
AI_MODEL_FALLBACK_1=openai/gpt-oss-120b
AI_MODEL_FALLBACK_2=llama-3.1-8b-instant

# --- Optional: embeddings for vector search -------------------
# Groq has no embedding models. Without these, retrieval uses BM25
# keyword ranking only, which works well for the small verified library.
# Any OpenAI-compatible /embeddings endpoint returning 1024-d vectors works.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=

# --- Retrieval ------------------------------------------------
RAG_TOP_K=8
