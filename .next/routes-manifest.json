{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/youth",
      "regex": "^/youth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth(?:/)?$"
    },
    {
      "page": "/youth/ask",
      "regex": "^/youth/ask(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth/ask(?:/)?$"
    },
    {
      "page": "/youth/find-help",
      "regex": "^/youth/find\\-help(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth/find\\-help(?:/)?$"
    },
    {
      "page": "/youth/onboarding",
      "regex": "^/youth/onboarding(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth/onboarding(?:/)?$"
    },
    {
      "page": "/youth/progress",
      "regex": "^/youth/progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth/progress(?:/)?$"
    },
    {
      "page": "/youth/steps",
      "regex": "^/youth/steps(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/youth/steps(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}