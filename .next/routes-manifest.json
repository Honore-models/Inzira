{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/cases/[caseId]/messages",
      "regex": "^/api/cases/([^/]+?)/messages(?:/)?$",
      "routeKeys": {
        "nxtPcaseId": "nxtPcaseId"
      },
      "namedRegex": "^/api/cases/(?<nxtPcaseId>[^/]+?)/messages(?:/)?$"
    },
    {
      "page": "/api/cases/[caseId]/steps",
      "regex": "^/api/cases/([^/]+?)/steps(?:/)?$",
