7:["$","section",null,{"id":"problem","className":"problem section split","children":[["$","div",null,{"className":"copy-block","children":[["$","p",null,{"className":"eyebrow","children":"The problem"}],["$","h2",null,{"children":"Everything a youth needs already exists. Finding it is the problem."}],["$","p",null,{"children":"RDB, BDF, and RTB all offer real, funded support for education, training, and business growth. But each institution assumes you already know what to do and in what order."}],["$","p",null,{"children":"As a result, many young people give up navigating between offices, or never discover help that could have worked for them."}],["$","p",null,{"className":"emphasis","children":"Inzira brings clarity, order, and human guidance to a system that was never connected."}]]}],["$","div",null,{"className":"image-frame","children":["$","$L10",null,{"src":"/youth.webp","alt":"Young Rwandan man seated in a crowd","width":764,"height":572,"priority":true}]}]]}]
